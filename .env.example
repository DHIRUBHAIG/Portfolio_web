# ============================================
# REQUIRED: Gmail SMTP Configuration
# ============================================

# Gmail account email address
EMAIL_USER=your-email@gmail.com

# Gmail App Password (NOT your regular password)
# Follow these steps to get it:
# 1. Enable 2-Factor Authentication on Gmail: https://myaccount.google.com/security
# 2. Go to App Passwords: https://myaccount.google.com/apppasswords
# 3. Select "Mail" and "Windows Computer" (or your device)
# 4. Generate and copy the 16-character password
# 5. Paste it here (without spaces)
EMAIL_PASS=xxxx xxxx xxxx xxxx

# Recipient email (where contact form submissions are sent)
NEXT_PUBLIC_CONTACT_EMAIL=dhirajkumarg413@gmail.com

# ============================================
# OPTIONAL: Analytics
# ============================================

ANALYTICS_API_KEY=your_analytics_key_here

# ============================================
# IMPORTANT SECURITY NOTES
# ============================================

# 1. NEVER commit .env.local to Git
# 2. Add .env.local to .gitignore (already done)
# 3. Always use Gmail App Password, not regular password
# 4. Create separate credentials for production
# 5. Rotate credentials regularly

